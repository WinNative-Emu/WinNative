#!/usr/bin/python3
# Completes the x86_64 root FEX runs Proton in, from Steam Linux Runtime's platform depot: the
# depot holds the /usr tree (bin, lib, lib64, etc, ...) as files plus an mtree naming the symlinks,
# empty directories and the deduplicated objects (contents=./xx/yyyy.bin) that pressure-vessel
# would hard-link in. That tree doubles as the root, with /usr pointing back at it.
#
#   winnative-fex-rootfs <steam root>   -> prints the rootfs path, or nothing when unavailable
import glob
import gzip
import os
import shutil
import sys


def parse(line):
    fields = line.split()
    entry = {"path": fields[0]}
    for field in fields[1:]:
        key, _, value = field.partition("=")
        entry[key] = value
    return entry


def materialize(platform, files):
    with gzip.open(os.path.join(platform, "usr-mtree.txt.gz"), "rt", encoding="utf-8") as f:
        entries = [parse(line) for line in f if line.startswith("./")]
    for entry in entries:
        target = os.path.join(files, entry["path"][2:])
        kind = entry.get("type")
        if kind == "dir":
            os.makedirs(target, exist_ok=True)
        elif kind == "link":
            if not os.path.islink(target):
                os.makedirs(os.path.dirname(target), exist_ok=True)
                os.symlink(entry["link"], target)
        elif kind == "file" and "contents" in entry and not os.path.exists(target):
            os.makedirs(os.path.dirname(target), exist_ok=True)
            shutil.copyfile(os.path.join(files, entry["contents"][2:]), target)
            os.chmod(target, int(entry.get("mode", "644"), 8))


def main():
    steam_root = sys.argv[1]
    platforms = sorted(glob.glob(os.path.join(
        steam_root, "steamapps/common/SteamLinuxRuntime_4/steamrt4_platform_*")))
    if not platforms:
        return
    platform = platforms[-1]
    files = os.path.join(platform, "files")
    stamp = os.path.join(files, ".winnative-version")
    version = os.path.basename(platform)
    if not (os.path.isfile(stamp) and open(stamp).read().strip() == version):
        materialize(platform, files)
        # The tree is /usr; as the root, /usr must resolve inside it.
        usr = os.path.join(files, "usr")
        if not os.path.islink(usr):
            os.symlink(".", usr)
        with open(stamp, "w") as f:
            f.write(version + "\n")
    print(files)


if __name__ == "__main__":
    main()
