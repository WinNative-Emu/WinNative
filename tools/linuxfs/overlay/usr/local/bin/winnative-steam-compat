#!/usr/bin/python3
# Registers winnative-proton with the native Steam client: linked into compatibilitytools.d and
# set as the default tool for Windows titles (CompatToolMapping "0" in config.vdf) when the user
# has not chosen one. Run before the client starts; it rewrites config.vdf on exit.
#
#   winnative-steam-compat <steam root>
import os
import re
import sys

TOOL = "winnative-proton"
TOOL_DIR = "/usr/local/share/winnative/proton-tool"
TOKEN = re.compile(r'\s*(?:"((?:[^"\\]|\\.)*)"|([{}])|//[^\n]*)')
# Steam's own Proton entries, which it runs through the Steam Linux Runtime's entry point.
BUILTIN_TOOL = re.compile(r'^"proton', re.IGNORECASE)


def tokenize(text):
    tokens = []
    pos = 0
    while pos < len(text):
        m = TOKEN.match(text, pos)
        if not m or m.end() == pos:
            break
        pos = m.end()
        if m.group(2):
            tokens.append(m.group(2))
        elif m.group(1) is not None:
            tokens.append('"' + m.group(1) + '"')
    return tokens


def find_block(tokens, path):
    """Index of the '{' opening the block at path, or None."""
    depth, want, i = 0, 0, 0
    while i < len(tokens):
        t = tokens[i]
        if t == "{":
            depth += 1
        elif t == "}":
            depth -= 1
            if depth < want:
                return None
        elif depth == want and i + 1 < len(tokens) and tokens[i + 1] == "{":
            if t.lower() == '"%s"' % path[want].lower():
                if want == len(path) - 1:
                    return i + 1
                want += 1
        i += 1
    return None


def block_end(tokens, start):
    depth = 0
    for i in range(start, len(tokens)):
        if tokens[i] == "{":
            depth += 1
        elif tokens[i] == "}":
            depth -= 1
            if depth == 0:
                return i
    return len(tokens)


def serialize(tokens):
    out, depth, i = [], 0, 0
    while i < len(tokens):
        t = tokens[i]
        if t == "}":
            depth -= 1
            out.append("\t" * depth + "}")
            i += 1
        elif i + 1 < len(tokens) and tokens[i + 1] == "{":
            out.append("\t" * depth + t)
            out.append("\t" * depth + "{")
            depth += 1
            i += 2
        else:
            out.append("\t" * depth + t + "\t\t" + tokens[i + 1])
            i += 2
    return "\n".join(out) + "\n"


def redirect_builtin_tools(tokens, mapping):
    """Points a game pinned to one of Steam's own Proton entries at this tool instead.

    Those entries are launched through the Steam Linux Runtime's entry point, which builds a
    container out of user namespaces this kernel does not have, so such a game never starts. This
    tool runs the same Valve Proton without the container.
    """
    changed = False
    i = mapping + 1
    end = block_end(tokens, mapping)
    while i < end:
        if i + 1 < len(tokens) and tokens[i + 1] == "{":
            child = i + 1
            child_end = block_end(tokens, child)
            for j in range(child + 1, child_end):
                if tokens[j] == '"name"' and j + 1 < child_end and BUILTIN_TOOL.match(tokens[j + 1]):
                    tokens[j + 1] = '"%s"' % TOOL
                    changed = True
            i = child_end + 1
        else:
            i += 2
    return changed


def register_default(config_path):
    with open(config_path, encoding="utf-8", errors="replace") as f:
        tokens = tokenize(f.read())
    steam = find_block(tokens, ["InstallConfigStore", "Software", "Valve", "Steam"])
    if steam is None:
        return
    mapping = find_block(tokens[steam + 1:], ["CompatToolMapping"])
    entry = ['"0"', "{", '"name"', '"%s"' % TOOL, '"config"', '""', '"priority"', '"75"', "}"]
    changed = False
    if mapping is None:
        end = block_end(tokens, steam)
        tokens[end:end] = ['"CompatToolMapping"', "{"] + entry + ["}"]
        changed = True
    else:
        mapping += steam + 1
        if find_block(tokens[mapping + 1:], ["0"]) is None:
            tokens[mapping + 1:mapping + 1] = entry
            changed = True
        if redirect_builtin_tools(tokens, mapping):
            changed = True
    if not changed:
        return
    tmp = config_path + ".winnative"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(serialize(tokens))
    os.replace(tmp, config_path)


def main():
    steam_root = sys.argv[1]
    tools = os.path.join(steam_root, "compatibilitytools.d")
    os.makedirs(tools, exist_ok=True)
    link = os.path.join(tools, TOOL)
    if os.path.islink(link) and os.readlink(link) != TOOL_DIR:
        os.unlink(link)
    # lexists, not exists: a link whose target is missing still occupies the name.
    if not os.path.lexists(link):
        os.symlink(TOOL_DIR, link)
    config = os.path.join(steam_root, "config", "config.vdf")
    if os.path.isfile(config):
        register_default(config)


if __name__ == "__main__":
    main()
