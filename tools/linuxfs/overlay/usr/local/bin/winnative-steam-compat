#!/usr/bin/python3
# Registers Valve's own ARM64 Proton with the native Steam client as a tool of this runtime.
#
# The depot is exactly what is wanted here - arm64ec Wine with FEX as the x86 layer - but its
# toolmanifest declares require_tool_appid 4185400, the arm64 Steam Linux Runtime, so the client
# stacks pressure-vessel underneath it. Pressure-vessel builds its container out of unprivileged
# user namespaces, which an Android app never gets, and the launch is dropped without a word: no
# window, no log, straight back to the library.
#
# So the depot is re-registered under a name of ours: every entry symlinked, so nothing is copied
# and the client still updates the real depot, beside a toolmanifest that leaves out that line.
# Proton takes its base directory from dirname(sys.argv[0]) without resolving it, so it reads
# files/ back through the symlink and runs on this rootfs.
#
#   winnative-steam-compat <steam root>
import os
import re
import sys

TOOL = "winnative-proton"
# Newest first; the client installs whichever the user has, and either one runs here.
SOURCES = ("Proton Experimental (ARM64)", "Proton 11.0 (ARM64)")
# The copy the app installs with the runtime, so the tool exists before the client first starts:
# the client reads its tools at startup alone, and a depot of its own only arrives after that.
BUNDLED = "/opt/winnative-proton"
# Written by us; everything else in the depot is symlinked through.
OWN_FILES = ("toolmanifest.vdf", "compatibilitytool.vdf", "winnative-launch")
# Where the app binds the user's own game library inside the session.
LIBRARY = "/mnt/winnative"
TOKEN = re.compile(r'\s*(?:"((?:[^"\\]|\\.)*)"|([{}])|//[^\n]*)')
# Steam's own Proton entries, which it runs through the Steam Linux Runtime's entry point.
BUILTIN_TOOL = re.compile(r'^"proton', re.IGNORECASE)
# Steam's own tools and runtimes live in steamapps beside the games; they are not titles and must
# not be mapped to a compatibility tool.
NOT_GAMES = frozenset((
    "228980",    # Steamworks Common Redistributables
    "1070560",   # Steam Linux Runtime 1.0 (scout)
    "1391110",   # Steam Linux Runtime 2.0 (soldier)
    "1493710",   # Proton Experimental
    "3127680",   # FEX
    "4183110",   # Steam Linux Runtime 4.0
    "4185400",   # Steam Linux Runtime 4.0 - Arm64
    "4427310",   # Proton Experimental (ARM64)
    "4628740",   # Proton 11.0 (ARM64)
))

TOOLMANIFEST = '''"manifest"
{
\t"version"\t\t"2"
\t"commandline"\t\t"/winnative-launch %verb%"
\t"use_sessions"\t\t"1"
\t"compatmanager_layer_name"\t\t"proton"
}
'''

# The client preloads its overlay library into every game. In a gamescope session the overlay is
# the client's own window, which gamescope layers over the game, so the library draws nothing - but
# it also stands in front of open() and read() on /dev/input. It lets Wine open the session's pad
# and then answers every read of it with nothing: the game sees a controller that never reports,
# and Wine's HID thread spins a core on a descriptor that is always ready and always empty.
# Proton is started without it; anything else the user preloads is kept.
LAUNCHER = '''#!/bin/sh
kept=
IFS=': '
for lib in $LD_PRELOAD; do
  case $lib in
    */gameoverlayrenderer.so) ;;
    *) kept=${kept:+$kept:}$lib ;;
  esac
done
unset IFS
if [ -n "$kept" ]; then export LD_PRELOAD="$kept"; else unset LD_PRELOAD; fi
exec "$(dirname "$0")/proton" "$@"
'''

COMPAT_TOOL_VDF = '''"compatibilitytools"
{
\t"compat_tools"
\t{
\t\t"%s"
\t\t{
\t\t\t"install_path"\t\t"."
\t\t\t"display_name"\t\t"Proton ARM64 (WinNative)"
\t\t\t"from_oslist"\t\t"windows"
\t\t\t"to_oslist"\t\t"linux"
\t\t}
\t}
}
''' % TOOL


def tokenize(text):
    tokens = []
    pos = 0
    while pos < len(text):
        m = TOKEN.match(text, pos)
        if not m or m.end() == pos:
            break
        pos = m.end()
        if m.group(2):
            tokens.append(m.group(2))
        elif m.group(1) is not None:
            tokens.append('"' + m.group(1) + '"')
    return tokens


def find_block(tokens, path):
    """Index of the '{' opening the block at path, or None."""
    depth, want, i = 0, 0, 0
    while i < len(tokens):
        t = tokens[i]
        if t == "{":
            depth += 1
        elif t == "}":
            depth -= 1
            if depth < want:
                return None
        elif depth == want and i + 1 < len(tokens) and tokens[i + 1] == "{":
            if t.lower() == '"%s"' % path[want].lower():
                if want == len(path) - 1:
                    return i + 1
                want += 1
        i += 1
    return None


def block_end(tokens, start):
    depth = 0
    for i in range(start, len(tokens)):
        if tokens[i] == "{":
            depth += 1
        elif tokens[i] == "}":
            depth -= 1
            if depth == 0:
                return i
    return len(tokens)


def serialize(tokens):
    out, depth, i = [], 0, 0
    while i < len(tokens):
        t = tokens[i]
        if t == "}":
            depth -= 1
            out.append("\t" * depth + "}")
            i += 1
        elif i + 1 < len(tokens) and tokens[i + 1] == "{":
            out.append("\t" * depth + t)
            out.append("\t" * depth + "{")
            depth += 1
            i += 2
        else:
            out.append("\t" * depth + t + "\t\t" + tokens[i + 1])
            i += 2
    return "\n".join(out) + "\n"


def redirect_builtin_tools(tokens, mapping):
    """Points a game pinned to one of Steam's own Proton entries at this tool instead.

    Those entries are launched through the Steam Linux Runtime's entry point, which builds a
    container out of user namespaces this kernel does not have, so such a game never starts. This
    tool runs the same Valve Proton without the container.
    """
    changed = False
    i = mapping + 1
    end = block_end(tokens, mapping)
    while i < end:
        if i + 1 < len(tokens) and tokens[i + 1] == "{":
            child = i + 1
            child_end = block_end(tokens, child)
            for j in range(child + 1, child_end):
                if tokens[j] == '"name"' and j + 1 < child_end and BUILTIN_TOOL.match(tokens[j + 1]):
                    tokens[j + 1] = '"%s"' % TOOL
                    changed = True
            i = child_end + 1
        else:
            i += 2
    return changed


def installed_apps(steam_root):
    """App ids of the titles the client has installed, its own tools and runtimes excluded."""
    apps = set()
    for library in (steam_root, LIBRARY):
        steamapps = os.path.join(library, "steamapps")
        try:
            names = os.listdir(steamapps)
        except OSError:
            continue
        for name in names:
            m = re.fullmatch(r"appmanifest_(\d+)\.acf", name)
            if m and m.group(1) not in NOT_GAMES:
                apps.add(m.group(1))
    return sorted(apps, key=int)


def register_default(config_path, apps=()):
    with open(config_path, encoding="utf-8", errors="replace") as f:
        tokens = tokenize(f.read())
    steam = find_block(tokens, ["InstallConfigStore", "Software", "Valve", "Steam"])
    if steam is None:
        return
    mapping = find_block(tokens[steam + 1:], ["CompatToolMapping"])
    entry = ['"0"', "{", '"name"', '"%s"' % TOOL, '"config"', '""', '"priority"', '"75"', "}"]
    changed = False
    if mapping is None:
        end = block_end(tokens, steam)
        tokens[end:end] = ['"CompatToolMapping"', "{"] + entry + ["}"]
        changed = True
    else:
        mapping += steam + 1
        if find_block(tokens[mapping + 1:], ["0"]) is None:
            tokens[mapping + 1:mapping + 1] = entry
            changed = True
        if redirect_builtin_tools(tokens, mapping):
            changed = True
        # "0" is the client's "Steam Play for all other titles", and it only decides how a title is
        # installed: anything already installed as a Linux build keeps running as one. An entry per
        # installed title is what the client's own Compatibility checkbox writes, and is what moves
        # a title across.
        for app in apps:
            if find_block(tokens[mapping + 1:], [app]) is not None:
                continue
            tokens[mapping + 1:mapping + 1] = [
                '"%s"' % app, "{", '"name"', '"%s"' % TOOL,
                '"config"', '""', '"priority"', '"250"', "}"]
            changed = True
    if not changed:
        return
    tmp = config_path + ".winnative"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(serialize(tokens))
    os.replace(tmp, config_path)


def find_depot(steam_root):
    for name in SOURCES:
        depot = os.path.join(steam_root, "steamapps", "common", name)
        if os.path.isfile(os.path.join(depot, "proton")):
            return depot
    if os.path.isfile(os.path.join(BUNDLED, "proton")):
        return BUNDLED
    return None


def discard(path):
    """Clears a name so a link may take it, leaving anything that is not ours alone."""
    if os.path.islink(path) or os.path.isfile(path):
        os.unlink(path)


def register_tool(steam_root, depot):
    """Mirrors the depot into compatibilitytools.d, minus its require_tool_appid."""
    tool_dir = os.path.join(steam_root, "compatibilitytools.d", TOOL)
    # An earlier release linked the whole directory; the mirror takes its place.
    if os.path.islink(tool_dir):
        os.unlink(tool_dir)
    os.makedirs(tool_dir, exist_ok=True)
    wanted = set(OWN_FILES)
    for name in os.listdir(depot):
        if name in OWN_FILES:
            continue
        wanted.add(name)
        link = os.path.join(tool_dir, name)
        target = os.path.join(depot, name)
        if os.path.islink(link) and os.readlink(link) == target:
            continue
        discard(link)
        if not os.path.lexists(link):
            os.symlink(target, link)
    # A name the depot no longer carries, left by an older version of it.
    for name in os.listdir(tool_dir):
        if name not in wanted:
            discard(os.path.join(tool_dir, name))
    for name, body in (("toolmanifest.vdf", TOOLMANIFEST),
                       ("compatibilitytool.vdf", COMPAT_TOOL_VDF),
                       ("winnative-launch", LAUNCHER)):
        path = os.path.join(tool_dir, name)
        discard(path)
        with open(path, "w", encoding="utf-8") as f:
            f.write(body)
    os.chmod(os.path.join(tool_dir, "winnative-launch"), 0o755)


def main():
    steam_root = sys.argv[1]
    depot = find_depot(steam_root)
    if depot is None:
        print("winnative-steam-compat: no ARM64 Proton depot yet; the client fetches it on first use",
              file=sys.stderr)
        return
    register_tool(steam_root, depot)
    print("winnative-steam-compat: registered %s from %s" % (TOOL, os.path.basename(depot)))
    config = os.path.join(steam_root, "config", "config.vdf")
    if os.path.isfile(config):
        apps = installed_apps(steam_root)
        register_default(config, apps)
        print("winnative-steam-compat: %d installed title(s) set to %s" % (len(apps), TOOL))


if __name__ == "__main__":
    main()
