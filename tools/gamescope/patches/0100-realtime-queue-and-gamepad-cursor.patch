diff --git a/src/steamcompmgr.cpp b/src/steamcompmgr.cpp
index 10990b8..08afbc4 100644
--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -2025,18 +2025,53 @@ void MouseCursor::UpdatePosition()
 	if ( pConstraint && pConstraint->current.cursor_hint.enabled )
 	{
 		m_bConstrained = true;
-
 		m_x = pConstraint->current.cursor_hint.x;
 		m_y = pConstraint->current.cursor_hint.y;
+		wlserver_unlock();
+		return;
 	}
-	else
+	m_bConstrained = false;
+	// Nothing to draw (the gamepad UI, most games): the position only feeds focus and zoom, and
+	// wlserver's copy is what stock gamescope uses for those. No round trip to X.
+	if ( m_imageEmpty )
 	{
-		m_bConstrained = false;
-
 		m_x = wlserver.mouse_surface_cursorx;
 		m_y = wlserver.mouse_surface_cursory;
+		wlserver_unlock();
+		return;
 	}
 	wlserver_unlock();
+
+	// The gamepad-driven cursor is moved through XTest, which moves the X pointer and nothing
+	// else: wlserver's copy of the position never changes, so the sprite sat frozen while the
+	// pointer moved. Ask X where the pointer is. (Armada 0001, on 3.16.29.) That is a blocking
+	// round trip to Xwayland on the paint thread, which waits while Xwayland is busy drawing the
+	// client's interface: once per vblank only while the sprite is shown, and every 50 ms while
+	// it is hidden for inactivity - enough to bring it back within a few frames of a move.
+	if ( wlserver.bCursorHidden )
+	{
+		const uint64_t now = get_time_in_nanos();
+		if ( now - m_ulLastPointerQuery < 50'000'000ul )
+			return;
+		m_ulLastPointerQuery = now;
+	}
+	Window root_ret, child_ret;
+	int root_x = m_x, root_y = m_y, win_x = 0, win_y = 0;
+	unsigned int mask;
+	XQueryPointer( m_ctx->dpy, DefaultRootWindow( m_ctx->dpy ),
+	               &root_ret, &child_ret,
+	               &root_x, &root_y,
+	               &win_x, &win_y,
+	               &mask );
+
+	if ( root_x != m_x || root_y != m_y )
+	{
+		m_x = root_x;
+		m_y = root_y;
+		wlserver.ulLastMovedCursorTime = get_time_in_nanos();
+		wlserver.bCursorHidden = !wlserver.bCursorHasImage;
+		hasRepaintNonBasePlane = true;
+	}
 }
 
