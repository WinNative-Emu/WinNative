+    // Touch
+
+    bool CWaylandInputThread::TouchToOutput( wl_surface *pSurface, wl_fixed_t fX, wl_fixed_t fY, double *pflX, double *pflY )
+    {
+        if ( !pSurface || !IsGamescopeToplevel( pSurface ) )
+            return false;
+        CWaylandPlane *pPlane = (CWaylandPlane *)wl_surface_get_user_data( pSurface );
+        if ( !pPlane )
+            return false;
+        auto oState = pPlane->GetCurrentState();
+        if ( !oState || !g_nOutputWidth || !g_nOutputHeight )
+            return false;
+        uint32_t uScale = oState->uFractionalScale;
+        *pflX = ( wl_fixed_to_double( fX ) * uScale / 120.0 + oState->nDestX ) / g_nOutputWidth;
+        *pflY = ( wl_fixed_to_double( fY ) * uScale / 120.0 + oState->nDestY ) / g_nOutputHeight;
+        return true;
+    }
+    // Touch ids are offset by one: the nested pointer already moves wlserver's touch 0.
+    void CWaylandInputThread::Wayland_Touch_Down( wl_touch *pTouch, uint32_t uSerial, uint32_t uTime, wl_surface *pSurface, int32_t nId, wl_fixed_t fX, wl_fixed_t fY )
+    {
+        double flX, flY;
+        if ( !TouchToOutput( pSurface, fX, fY, &flX, &flY ) )
+            return;
+        m_TouchSurfaces[ nId ] = pSurface;
+        wlserver_lock();
+        wlserver_touchdown( flX, flY, nId + 1, ++m_uFakeTimestamp );
+        wlserver_unlock();
+    }
+    void CWaylandInputThread::Wayland_Touch_Up( wl_touch *pTouch, uint32_t uSerial, uint32_t uTime, int32_t nId )
+    {
+        if ( m_TouchSurfaces.erase( nId ) == 0 )
+            return;
+        wlserver_lock();
+        wlserver_touchup( nId + 1, ++m_uFakeTimestamp );
+        wlserver_unlock();
+    }
+    void CWaylandInputThread::Wayland_Touch_Motion( wl_touch *pTouch, uint32_t uTime, int32_t nId, wl_fixed_t fX, wl_fixed_t fY )
+    {
+        auto it = m_TouchSurfaces.find( nId );
+        if ( it == m_TouchSurfaces.end() )
+            return;
+        double flX, flY;
+        if ( !TouchToOutput( it->second, fX, fY, &flX, &flY ) )
+            return;
+        wlserver_lock();
+        wlserver_touchmotion( flX, flY, nId + 1, ++m_uFakeTimestamp );
+        wlserver_unlock();
+    }
+    void CWaylandInputThread::Wayland_Touch_Frame( wl_touch *pTouch )
+    {
+    }
+    void CWaylandInputThread::Wayland_Touch_Cancel( wl_touch *pTouch )
+    {
+        wlserver_lock();
+        for ( auto &[ nId, pSurface ] : m_TouchSurfaces )
+            wlserver_touchup( nId + 1, ++m_uFakeTimestamp );
+        wlserver_unlock();
+        m_TouchSurfaces.clear();
     }
 
