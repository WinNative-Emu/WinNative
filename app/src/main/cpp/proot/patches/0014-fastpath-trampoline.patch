From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DroidDeck <droiddeck@users.noreply.github.com>
Date: Wed, 30 Sep 2026 00:00:00 +0000
Subject: [PATCH] fastpath: let translated syscalls from the tracee's trampoline
 page through, and keep the kernel's cwd at the guest's

With PROOT_FASTPATH set (and only then), every SECCOMP_RET_TRACE in the filter
is preceded by a check of the caller's address: a syscall made from the fast
path's trampoline page (tools/proot/fastpath, FASTPATH_STUB_ADDR) was already
translated inside the tracee and runs without a stop. The check follows the
syscall-number dispatch, so untraced syscalls stay constant-ALLOW and keep the
kernel's seccomp action cache. chdir/fchdir, emulated as before, also move the
kernel's cwd to the host directory (host "/" where the kernel cannot follow),
and the first tracee starts there, so relative lookups made inside the tracee
resolve where proot resolves them. Without PROOT_FASTPATH nothing changes.
---
--- a/src/syscall/enter.c
+++ b/src/syscall/enter.c
@@ -20,7 +20,8 @@
  * 02110-1301 USA.
  */
 
-#include <errno.h>       /* errno(3), E* */
+#include <errno.h>
+#include <stdlib.h>       /* errno(3), E* */
 #include <talloc.h>      /* talloc_*, */
 #include <sys/un.h>      /* struct sockaddr_un, */
 #include <linux/net.h>   /* SYS_*, */
@@ -198,6 +199,20 @@
 		if ((statl.st_mode & S_IXUSR) == 0)
 			return -EACCES;
 
+		/* With the fast path, the kernel's cwd follows the guest's
+		 * (at its host path), so relative lookups made inside the
+		 * tracee resolve where proot would resolve them.  */
+		if (getenv("PROOT_FASTPATH") != NULL) {
+			int fd = open(path, O_PATH | O_DIRECTORY | O_CLOEXEC);
+
+			/* Where the kernel could not follow, it goes to the
+			 * host's "/", which no binding names: the fast path
+			 * then sends every relative lookup to proot.  */
+			strcpy(oldpath, fd >= 0 ? path : "/");
+			if (fd >= 0)
+				close(fd);
+		}
+
 		/* Sadly this method doesn't detranslate statefully,
 		 * this means that there's an ambiguity when several
 		 * bindings are from the same host path:
@@ -229,6 +244,14 @@
 		tracee->fs->cwd = tmp;
 		talloc_set_name_const(tracee->fs->cwd, "$cwd");
 
+		if (getenv("PROOT_FASTPATH") != NULL) {
+			/* fchdir(2) runs as it is; chdir(2) on the host path.  */
+			status = syscall_number == PR_chdir
+				? set_sysarg_path(tracee, oldpath, SYSARG_1)
+				: 0;
+			break;
+		}
+
 		set_sysnum(tracee, PR_void);
 		status = 0;
 		break;
