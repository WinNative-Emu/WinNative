From: WinNative <maxjivi05@users.noreply.github.com>
Date: Sat, 10 Oct 2026 00:00:00 +0000
Subject: [PATCH] read the tracee's memory by untagged addresses

---
 src/tracee/mem.c | 31 +++++++++++++++++++++++++++----
 1 file changed, 27 insertions(+), 4 deletions(-)

diff --git a/src/tracee/mem.c b/src/tracee/mem.c
index 925f4bd..0d75bdf 100644
--- a/src/tracee/mem.c
+++ b/src/tracee/mem.c
@@ -61,6 +61,25 @@ __asm(
 #endif /* defined(__aarch64__) */
 #endif /* HAS_POKEDATA_WORKAROUND */
 
+/**
+ * The @address without the tag an arm64 pointer may carry in its top byte.
+ *
+ * Android's allocator tags heap pointers, and the first program is started by
+ * PRoot's own child, from its heap: execve(2) arrives with 0xb4... addresses
+ * for the path and the environment.  Some kernels (seen on 6.1) do not read a
+ * tagged address on a tracer's behalf, through process_vm_readv(2) or ptrace(2),
+ * and nothing then starts.  Guest addresses carry no tag, so this costs them
+ * nothing.
+ */
+static inline word_t untagged(word_t address)
+{
+#if defined(__aarch64__)
+	return address & 0x00FFFFFFFFFFFFFFULL;
+#else
+	return address;
+#endif
+}
+
 /**
  * Load the word at the given @address, potentially *not* aligned.
  */
@@ -218,7 +237,7 @@ void mem_prepare_before_first_execve(Tracee *tracee)
 int write_data(Tracee *tracee, word_t dest_tracee, const void *src_tracer, word_t size)
 {
 	word_t *src  = (word_t *)src_tracer;
-	word_t *dest = (word_t *)dest_tracee;
+	word_t *dest = (word_t *)untagged(dest_tracee);
 
 	long   status;
 	word_t word, i, j;
@@ -308,7 +327,7 @@ int writev_data(Tracee *tracee, word_t dest_tracee, const struct iovec *src_trac
 	for (i = 0, size = 0; i < src_tracer_count; i++)
 		size += src_tracer[i].iov_len;
 
-	remote.iov_base = (word_t *)dest_tracee;
+	remote.iov_base = (word_t *)untagged(dest_tracee);
 	remote.iov_len  = size;
 
 	status = process_vm_writev(tracee->pid, src_tracer, src_tracer_count, &remote, 1, 0);
@@ -337,7 +356,7 @@ int writev_data(Tracee *tracee, word_t dest_tracee, const struct iovec *src_trac
  */
 int read_data(const Tracee *tracee, void *dest_tracer, word_t src_tracee, word_t size)
 {
-	word_t *src  = (word_t *)src_tracee;
+	word_t *src  = (word_t *)untagged(src_tracee);
 	word_t *dest = (word_t *)dest_tracer;
 
 	word_t nb_trailing_bytes;
@@ -411,7 +430,7 @@ int read_data(const Tracee *tracee, void *dest_tracer, word_t src_tracee, word_t
  */
 int read_string(const Tracee *tracee, char *dest_tracer, word_t src_tracee, word_t max_size)
 {
-	word_t *src  = (word_t *)src_tracee;
+	word_t *src  = (word_t *)untagged(src_tracee);
 	word_t *dest = (word_t *)dest_tracer;
 
 	word_t nb_trailing_bytes;
@@ -544,6 +563,8 @@ word_t peek_word(const Tracee *tracee, word_t address)
 {
 	word_t result = 0;
 
+	address = untagged(address);
+
 #if defined(HAVE_PROCESS_VM)
 	int status;
 	struct iovec local;
@@ -587,6 +608,8 @@ void poke_word(const Tracee *tracee, word_t address, word_t value)
 {
 	word_t tmp;
 
+	address = untagged(address);
+
 #if defined(HAVE_PROCESS_VM)
 	int status;
 	struct iovec local;
-- 
