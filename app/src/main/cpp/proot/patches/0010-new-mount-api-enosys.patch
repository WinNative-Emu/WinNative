From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DroidDeck <noreply@droiddeck.invalid>
Date: Tue, 29 Sep 2026 08:00:00 -0400
Subject: [PATCH] syscall: answer the new mount API with ENOSYS

open_tree(AT_FDCWD, "/") and its relatives take paths proot never
translates, so libglnx (Flatpak) got a descriptor for the host root and
created directories there. Unsupported, callers fall back to openat.
---
diff --git a/src/syscall/enter.c b/src/syscall/enter.c
index 1d3b3fd..32d2503 100644
--- a/src/syscall/enter.c
+++ b/src/syscall/enter.c
@@ -465,6 +465,15 @@ int translate_syscall_enter(Tracee *tracee)
 		status = -ENOSYS;
 		break;
 
+	/* The new mount API opens and moves paths proot never sees: open_tree(AT_FDCWD, "/")
+	 * hands back the host's root. Callers (libglnx, systemd) fall back to openat. */
+	case PR_open_tree:
+	case PR_move_mount:
+	case PR_fspick:
+	case PR_mount_setattr:
+		status = -ENOSYS;
+		break;
+
 	case PR_inotify_add_watch:
 		flags = peek_reg(tracee, CURRENT, SYSARG_3);
 
diff --git a/src/syscall/seccomp.c b/src/syscall/seccomp.c
index 0b381bb..6ba7b67 100644
--- a/src/syscall/seccomp.c
+++ b/src/syscall/seccomp.c
@@ -457,6 +457,10 @@ static FilteredSysnum proot_sysnums[] = {
 	{ PR_open,		0 },
 	{ PR_openat,		0 },
 	{ PR_openat2,		0 },
+	{ PR_open_tree,		0 },
+	{ PR_move_mount,	0 },
+	{ PR_fspick,		0 },
+	{ PR_mount_setattr,	0 },
 	{ PR_pivot_root,	0 },
 	{ PR_prctl, 		0 },
 	{ PR_prlimit64,		FILTER_SYSEXIT },
