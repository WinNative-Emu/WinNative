#version 450

// DIS (Dense Inverse Search) interpolation pass. Warps the previous and next
// frames by the dense flow and blends them at time t.

precision highp float;
precision highp int;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D prevColor;
layout(set = 0, binding = 1) uniform sampler2D nextColor;
layout(set = 0, binding = 2) uniform sampler2D flowTex;
layout(set = 0, binding = 5, rgba8) uniform image2D outImage;

layout(push_constant) uniform PC {
    float t;
    int debugMode;
} pc;

// Linear filtering of 32-bit float formats is an optional Vulkan feature, and
// the dense flow this pass samples is R32G32_SFLOAT. Most parts have it; some
// mobile GPUs filter only 16-bit floats. Rather than assume, the host asks the
// driver and sets this constant, so the branch is resolved when the pipeline is
// built and costs nothing per pixel.
layout(constant_id = 0) const int manualFlowFilter = 0;

// Bilinear by hand, for the devices that cannot do it in the sampler. Same
// footprint and same weights the sampler would have used, with the edge clamp
// spelled out.
vec2 sampleFlow(vec2 uv) {
    if (manualFlowFilter == 0) return textureLod(flowTex, uv, 0.0).xy;

    vec2 sz = vec2(textureSize(flowTex, 0));
    vec2 p = uv * sz - 0.5;
    vec2 frac = fract(p);
    ivec2 i0 = ivec2(floor(p));
    ivec2 mx = ivec2(sz) - 1;

    vec2 a = texelFetch(flowTex, clamp(i0,                ivec2(0), mx), 0).xy;
    vec2 b = texelFetch(flowTex, clamp(i0 + ivec2(1, 0), ivec2(0), mx), 0).xy;
    vec2 c = texelFetch(flowTex, clamp(i0 + ivec2(0, 1), ivec2(0), mx), 0).xy;
    vec2 e = texelFetch(flowTex, clamp(i0 + ivec2(1, 1), ivec2(0), mx), 0).xy;
    return mix(mix(a, b, frac.x), mix(c, e, frac.x), frac.y);
}

vec3 hsv2rgb(vec3 c) {
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImage);
    if (pix.x >= size.x || pix.y >= size.y) return;

    vec2 uv = (vec2(pix) + 0.5) / vec2(size);
    vec2 texel = 1.0 / vec2(size);

    // Flow along a trailing edge is not merely noisy, it is unrecoverable: the
    // content that sat there in prevColor has already left the frame in
    // nextColor, so the patch search had nothing to match and settled near zero
    // instead of the real displacement. A near-zero flow then passes the
    // out-of-frame test below, and the pixel gets a plain crossfade between two
    // frames tens of pixels apart. That is the ghosted band down the left and
    // right edges while panning horizontally; a vertical pan puts it on the top
    // and bottom edges instead, and a still camera shows nothing at all.
    //
    // Borrow the flow from just inside, across a narrow strip only.
    //
    // This used to be a wide band that grew with the measured displacement, back
    // when the frame border still carried genuinely broken vectors. It does not
    // any more: DIS is cropped to the content rect so the letterbox boundary is
    // gone, and a patch whose warp had to be clamped now keeps the coarse
    // estimate instead of whatever Gauss-Newton wandered into. What remains to
    // cover is only the strip where the sparse grid runs out of neighbours,
    // which is a patch or two wide.
    //
    // Keeping the wide version actively hurt: near an edge the flow is often
    // legitimately different from the interior - the floor along the bottom of
    // the frame is closer to the camera and moves faster than the background -
    // and overwriting it with an interior value drew a band right there.
    const float GUARD_PX = 20.0;
    vec2 guard = GUARD_PX * texel;

    vec2 dEdge = min(uv, 1.0 - uv);
    vec2 ramp = clamp((dEdge - guard) / max(guard, texel), 0.0, 1.0);
    vec2 eased = ramp * ramp * (3.0 - 2.0 * ramp);
    float edgeMix = min(eased.x, eased.y);

    vec2 f = sampleFlow(uv);
    if (edgeMix < 1.0) {
        // Only the guard strip needs the borrowed value. The branch is coherent
        // across a workgroup - whole tiles are interior - so the interior pays
        // nothing for it, and this pass runs once per generated frame at full
        // content resolution, where one saved tap per pixel is worth having.
        vec2 fInner = sampleFlow(clamp(uv, guard, 1.0 - guard));
        f = mix(fInner, f, edgeMix);
    }

    if (pc.debugMode != 0) {
        // HSV color wheel: hue from flow direction, saturation from magnitude.
        // f is normalized, so scale by the full-res width to get pixels.
        float m = length(f) * float(size.x) / 16.0;
        float hue = atan(f.y, f.x) / 6.2831853 + 0.5;
        vec3 fc = hsv2rgb(vec3(hue, clamp(m, 0.0, 1.0), min(1.0, 0.15 + m)));
        imageStore(outImage, pix, vec4(fc, 1.0));
        return;
    }

    // Warped sample positions. At the image borders the flow can legitimately
    // push a sample off-frame (content entering/leaving during a pan): sampling
    // there would clamp to the edge and smear it across the border.
    vec2 uv0 = uv - pc.t * f;
    vec2 uv1 = uv + (1.0 - pc.t) * f;

    vec3 c0 = textureLod(prevColor, clamp(uv0, vec2(0.0), vec2(1.0)), 0.0).xyz;
    vec3 c1 = textureLod(nextColor, clamp(uv1, vec2(0.0), vec2(1.0)), 0.0).xyz;

    vec3 single = pc.t < 0.5 ? c0 : c1;

    // How far each warped sample landed outside the frame, ramped to 1 over
    // FEATHER_PX. A hard in/out test here switched the whole pixel to a single
    // source the moment the warp crossed the edge, which drew a visible seam
    // down both borders; ramping the weight instead fades between the two.
    // Deep inside the frame both ramps are 0 and this is exactly mix(c0, c1, t).
    const float FEATHER_PX = 8.0;
    vec2 feather = FEATHER_PX / vec2(size);
    vec2 e0 = max(max(-uv0, uv0 - vec2(1.0)), vec2(0.0)) / feather;
    vec2 e1 = max(max(-uv1, uv1 - vec2(1.0)), vec2(0.0)) / feather;
    float out0 = clamp(max(e0.x, e0.y), 0.0, 1.0);
    float out1 = clamp(max(e1.x, e1.y), 0.0, 1.0);

    float w0 = (1.0 - pc.t) * (1.0 - out0);
    float w1 = pc.t * (1.0 - out1);
    float wsum = w0 + w1;

    vec3 result = wsum > 1e-4
        ? (c0 * w0 + c1 * w1) / wsum
        : (out0 <= out1 ? c0 : c1);

    // Occlusion / flow-error heuristic: when the two warped samples disagree
    // strongly, the pixel is likely disoccluded, so blending would ghost.
    float occl = smoothstep(0.10, 0.40, dot(abs(c0 - c1), vec3(1.0)));
    result = mix(result, single, occl);

    imageStore(outImage, pix, vec4(result, 1.0));
}
