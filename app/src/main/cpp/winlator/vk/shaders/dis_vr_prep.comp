#version 450

// Variational refinement prep: warps the next frame by the current flow and
// produces the averaged image plus the residual (Iz = I1 - I0). Also clears the
// dW buffer to zero (folded here to avoid a separate clear pass).

precision highp float;
precision highp int;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D prevColor;
layout(set = 0, binding = 1) uniform sampler2D nextColor;
layout(set = 0, binding = 2) uniform sampler2D flowDense;   // normalized flow
layout(set = 0, binding = 8, rg32f) uniform image2D prep;
layout(set = 0, binding = 9, rg32f) uniform image2D dW;

// Luminance is returned on the 0-255 scale the reference implementation works
// on, not the 0-1 the samplers hand back. Every tuned constant downstream - the
// densify confidence epsilon, the variational refinement's delta/gamma/zeta -
// came from OpenCV, which feeds this chain 8-bit imagery converted to float
// without dividing by 255. Feeding it 0-1 instead left those constants
// mismatched by that same factor.
float uluminance(vec3 c) {
    return (0.299 * c.x + 0.587 * c.y + 0.114 * c.z) * 255.0;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(prep);
    if (p.x >= sz.x || p.y >= sz.y) return;

    vec2 invSize = 1.0 / vec2(sz);
    float i0 = uluminance(texelFetch(prevColor, p, 0).xyz);
    vec2 fn = texelFetch(flowDense, p, 0).xy;
    float w = uluminance(textureLod(nextColor, (vec2(p) + 0.5) * invSize + fn, 0.0).xyz);

    imageStore(prep, p, vec4(0.5 * (i0 + w), w - i0, 0.0, 0.0));
    imageStore(dW, p, vec4(0.0));
}
