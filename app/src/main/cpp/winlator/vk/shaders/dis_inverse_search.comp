#version 450

// DIS (Dense Inverse Search) inverse-search pass. Refines a sparse optical
// flow estimate (prev -> next) with Gauss-Newton iterations over 8x8 patches.
// Runs coarse-to-fine: the initial flow comes from the coarser pyramid level
// (or the previous frame at the coarsest level), and finer levels do fewer
// iterations.

precision highp float;
precision highp int;

// Gauss-Newton descent iterations per pyramid level. Fixed (and compile-time)
// so every level, including the coarsest, converges from a zero start instead of
// relying on the previous frame's flow (which lags on small per-frame motion).
// 8 is a balance; the improved reference uses 16 on fewer levels.
#define DIS_INVERSE_ITERS 8

// Largest residual, as an RMS luminance difference on the 0-255 scale, that
// still counts as a match. Above it the block was not found at all, which is the
// normal state of affairs on either side of a moving object: the background just
// ahead of it is covered in the next frame and the background just behind it was
// covered in the previous one, so no displacement whatsoever aligns them. Left
// unchecked, Gauss-Newton still returns something, and that something is the
// halo of wrongly-directed flow that rings every moving object. Falling back to
// the coarser level's estimate puts the background's own motion there instead:
// one level up the patch is larger than the object, so the background dominates
// it. Raise this to accept weaker matches, lower it to trust fewer of them.
#define DIS_MAX_MATCH_RMS 36.0

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// lastLumaMap/nextLumaMap are the precomputed luminance pyramid, not colour:
// one channel, already on the 0-255 scale the tuned constants expect. The dot
// product that used to run on every one of these fetches now runs once per texel
// in dis_luma.comp.
layout(set = 0, binding = 0) uniform sampler2D lastLumaMap;   // prev luma at this level
layout(set = 0, binding = 1) uniform sampler2D nextLumaMap;   // next luma at this level
layout(set = 0, binding = 2) uniform sampler2D lastGradientMap; // prev gradient at this level
layout(set = 0, binding = 3) uniform sampler2D flowMap;        // coarser dense flow (level+1)
layout(set = 0, binding = 4) uniform sampler2D lastFlowMap;    // temporal coarsest flow
// rgba32f, not rg32f: .z carries the mean-normalized SSD of the vector stored
// here, so a propagation pass need not re-score the candidate it is already
// holding. -1 means "not scored yet".
layout(set = 0, binding = 5, rgba32f) uniform image2D sparseFlowMap;

layout(push_constant) uniform PC {
    int level;
    int coarseLevel;
} pc;

// Luminance is returned on the 0-255 scale the reference implementation works
// on, not the 0-1 the samplers hand back. Every tuned constant downstream - the
// densify confidence epsilon, the variational refinement's delta/gamma/zeta -
// came from OpenCV, which feeds this chain 8-bit imagery converted to float
// without dividing by 255. Feeding it 0-1 instead left those constants
// mismatched by that same factor.
float uluminance(vec3 c) {
    return (0.299 * c.x + 0.587 * c.y + 0.114 * c.z) * 255.0;
}

float myDeterminant(mat2 m) {
    return m[0][0] * m[1][1] - m[0][1] * m[1][0];
}

mat2 myInverse(mat2 m) {
    float det = myDeterminant(m);
    if (abs(det) < 1e-10) return mat2(0.0);
    return mat2(m[1][1], -m[0][1], -m[1][0], m[0][0]) / det;
}

void main() {
    const float patchSize = 8.0;

    ivec2 pixSparse = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sparseSize = imageSize(sparseFlowMap);
    if (pixSparse.x >= sparseSize.x || pixSparse.y >= sparseSize.y) return;

    ivec2 pix = pixSparse * 3;
    ivec2 denseSize = textureSize(lastLumaMap, 0);
    ivec2 denseMax = denseSize - 1;

    float lastImageData[64];
    vec2 gradData[64];

    vec2 gradSum = vec2(0.0);
    mat2 H = mat2(0.0);

    for (int i = 0; i < 8; i++) {
        for (int j = 0; j < 8; j++) {
            ivec2 q = clamp(pix + ivec2(i, j), ivec2(0), denseMax);
            gradData[i * 8 + j] = -texelFetch(lastGradientMap, q, 0).xy;

            H[0][0] += gradData[i * 8 + j].x * gradData[i * 8 + j].x;
            H[1][1] += gradData[i * 8 + j].y * gradData[i * 8 + j].y;
            H[0][1] += gradData[i * 8 + j].x * gradData[i * 8 + j].y;

            lastImageData[i * 8 + j] =
                texelFetch(lastLumaMap, q, 0).x;

            gradSum += gradData[i * 8 + j];
        }
    }

    H[1][0] = H[0][1];
    if (myDeterminant(H) < 1e-6) {
        H[0][0] += 1e-6;
        H[1][1] += 1e-6;
    }
    mat2 H_inv = myInverse(H);

    vec2 flow;
    if (pc.level == pc.coarseLevel) {
        // Start from zero instead of the previous frame's flow: the temporal
        // prior dominates on small (sub-pixel) flow and lags on changing motion.
        flow = vec2(0.0);
    } else {
        ivec2 fmMax = textureSize(flowMap, 0) - 1;
        vec4 cf = texelFetch(flowMap, clamp(ivec2(pix / 2) + 2, ivec2(0), fmMax), 0);
        flow = cf.xy * vec2(denseSize);
        if (any(isnan(flow)) || any(isinf(flow))) flow = vec2(0.0);
    }
    vec2 initialFlow = flow;

    vec2 invImageSize = 1.0 / vec2(denseSize);
    const float N = 64.0;

    const float N_INV = 1.0 / N;
    float prevSSD = 1e10;
    for (int iter = 0; iter < DIS_INVERSE_ITERS; iter++) {
        // Clamp the patch origin like OpenCV (clampPos): the warp slides to the
        // border but never leaves the image, so all 64 samples are always
        // evaluated and the mean-normalized N stays valid.
        //
        // The upper bound must be denseSize - patchSize, not denseSize - 1. With
        // -1 the patch hangs 7 texels past the edge and CLAMP_TO_EDGE collapses
        // those columns onto one texel: the patch goes flat along that axis, the
        // SSD carries no gradient information, and the Gauss-Newton step returns
        // noise. That produced the artifact bands down the left and right edges
        // of every generated frame, roughly patchSize + |flow| wide.
        vec2 warpOrigin = clamp(vec2(pix) + flow, vec2(0.0), vec2(denseSize) - patchSize);
        float sd = 0.0;
        float sd2 = 0.0;
        vec2 sIg = vec2(0.0);

        for (int i = 0; i < 8; i++) {
            for (int j = 0; j < 8; j++) {
                vec2 tc = (warpOrigin + vec2(i, j) + 0.5) * invImageSize;
                float warped = textureLod(nextLumaMap, tc, 0.0).x;
                float diff = warped - lastImageData[i * 8 + j];
                sd += diff;
                sd2 += diff * diff;
                sIg += gradData[i * 8 + j] * diff;
            }
        }

        // Mean-normalized Gauss-Newton step (matches OpenCV dis_flow).
        vec2 dU = sIg - sd * gradSum / N;
        float SSD = sd2 - sd * sd / N;

        flow -= H_inv * dU;

        if (SSD >= prevSSD) break;
        prevSSD = SSD;
    }

    // Reject a diverged estimate (moved more than a whole patch from the initial
    // guess) or NaN/Inf. A large but well-converged flow is kept: clampPos
    // already keeps the patch in bounds while sampling, so there is no need to
    // reject a flow whose patch centre leaves the image - that was over-aggressive
    // and collapsed fast horizontal motion (and thus the left/right borders) back
    // to the small initial flow. Matches OpenCV's dis_flow.
    // NaN/Inf must be tested explicitly: the comparisons below are all false for
    // NaN/Inf, so a divergent patch would otherwise leak NaN into the dense flow.
    //
    // Separately: if the patch had to be clamped to stay in frame, the warp it
    // scored was not the warp it asked for. Part of the block sampled clamped
    // edge texels, so its SSD is not evidence of anything, and Gauss-Newton is
    // free to run off in an arbitrary direction. That is where the large,
    // wrongly-directed vectors along the frame border come from. Keep the
    // coarser level's estimate instead: it was computed with a wider field of
    // view and actually saw the motion.
    vec2 wantOrigin = vec2(pix) + flow;
    vec2 maxOrigin = vec2(denseSize) - patchSize;
    bool clamped = any(lessThan(wantOrigin, vec2(-0.5)))
                || any(greaterThan(wantOrigin, maxOrigin + 0.5));

    // prevSSD holds the best mean-normalized sum of squared differences reached,
    // so dividing by the sample count gives the per-pixel variance of the
    // residual and its square root is an RMS luminance error.
    bool unmatched = prevSSD * N_INV > DIS_MAX_MATCH_RMS * DIS_MAX_MATCH_RMS;

    if (any(isnan(flow)) || any(isinf(flow)) || clamped || unmatched ||
        length(flow - initialFlow) > patchSize) {
        flow = initialFlow;
    }

    flow *= invImageSize;
    // .z = -1: this vector has not been scored with the mean-normalized SSD the
    // propagation passes use. Their own metric is not the Gauss-Newton residual
    // tracked here, so seeding it with that would bias the first comparison.
    imageStore(sparseFlowMap, pixSparse, vec4(flow, -1.0, 1.0));
}
